{
  "schema_version": "0.2",
  "name": "dev-synthetic-semantics",
  "note": "合成开发集·语义卷（§9.1 公开仓库只放合成 fixture）：匹配语义、时间/分支/排序。profile 为本地审核语义（允许全部 scope），策略对抗另见 dev-synthetic-policy.json。真实标注问题集保存于 Git 外私有评测目录。",
  "profile": {
    "name": "local-eval",
    "allow_scopes": ["*"],
    "allow_unclassified": true,
    "deny_sensitivity": [],
    "delivery_boundary": "local_only"
  },
  "cases": [
    { "id": "kw-01", "type": "keyword", "query": "职业",
      "acceptable_event_ids": ["chatgpt:testuser:job01", "chatgpt:testuser:rel01", "chatgpt:testuser:both", "chatgpt:testuser:early", "chatgpt:testuser:undat"],
      "must_distinguish": "「职业」二元 token 命中；不得混入仅含「求职」的记录",
      "attribution": { "owner": ["chatgpt:testuser:job01", "chatgpt:testuser:rel01"] } },
    { "id": "kw-02", "type": "keyword", "query": "求职",
      "acceptable_event_ids": ["chatgpt:testuser:seek01", "chatgpt:testuser:both"],
      "must_distinguish": "「求职」≠「职业」；both 同时含两词" },
    { "id": "kw-03", "type": "keyword", "query": "安全",
      "acceptable_event_ids": ["chatgpt:testuser:sec01"],
      "forbidden_event_ids": ["chatgpt:testuser:hanzi"],
      "must_distinguish": "「安全」连续子串；单独「安」不构成「安全」" },
    { "id": "kw-04", "type": "keyword", "query": "AI",
      "acceptable_event_ids": ["chatgpt:testuser:ai01", "chatgpt:testuser:mix01", "chatgpt:testuser:wide"],
      "must_distinguish": "拉丁词内子串与独立 token 同命中（learning/daily 词内 ai）" },
    { "id": "kw-05", "type": "keyword", "query": "AI工程",
      "acceptable_event_ids": ["chatgpt:testuser:mix01", "chatgpt:testuser:wide"],
      "must_distinguish": "混合词整串连续；FTS 仅用「工程」缩候选后验证整串" },
    { "id": "kw-06", "type": "keyword", "query": "你好，世界",
      "acceptable_event_ids": ["chatgpt:testuser:punct"],
      "must_distinguish": "标点为归一化保留字符，连续子串匹配" },
    { "id": "kw-07", "type": "keyword", "query": "职业方向",
      "acceptable_event_ids": ["chatgpt:testuser:job01"],
      "forbidden_event_ids": ["chatgpt:testuser:rel01", "chatgpt:testuser:both", "chatgpt:testuser:early", "chatgpt:testuser:undat"],
      "must_distinguish": "「职业方向」整词连续，不得被仅含「职业」的记录稀释" },
    { "id": "kw-08", "type": "keyword", "query": "安",
      "acceptable_event_ids": ["chatgpt:testuser:sec01", "chatgpt:testuser:hanzi"],
      "must_distinguish": "单汉字回退路径（FTS 不安全）：词内命中与独立命中都算" },
    { "id": "kw-09", "type": "keyword", "query": "Learning",
      "acceptable_event_ids": ["chatgpt:testuser:ai01"],
      "must_distinguish": "拉丁整词大小写折叠命中" },
    { "id": "kw-10", "type": "keyword", "query": "earn",
      "acceptable_event_ids": ["chatgpt:testuser:ai01"],
      "must_distinguish": "拉丁词内子串回退路径：learning 含 earn → 命中 ai01" },

    { "id": "mt-01", "type": "multi_temporal", "query": "职业", "order": "chronological",
      "acceptable_event_ids": ["chatgpt:testuser:early"],
      "must_distinguish": "最早提到用时间排序：early(07-31T20:00Z) 必须出现在前 10 首位" },
    { "id": "mt-02", "type": "multi_temporal", "query": "职业", "order": "reverse_chronological",
      "acceptable_event_ids": ["chatgpt:testuser:both"],
      "must_distinguish": "最新优先：both(T0+480) 为含「职业」的已知时间最新记录（wide 更晚但不含职业）" },
    { "id": "mt-03", "type": "multi_temporal", "query": "重复职业", "order": "relevance",
      "acceptable_event_ids": ["chatgpt:testuser:rel01"],
      "must_distinguish": "「重复职业」连续子串仅 rel01；相关性排序不影响事实有效性" },
    { "id": "mt-04", "type": "multi_temporal", "query": "职业 求职", "match_mode": "all_terms",
      "acceptable_event_ids": ["chatgpt:testuser:both"],
      "must_distinguish": "all_terms 双词交集；literal 带空格应 0 命中（见 in-03）" },
    { "id": "mt-05", "type": "multi_temporal", "query": "偏理论", "branch_scope": "selected",
      "expected_access": "deny", "allowed_refusal": true,
      "forbidden_event_ids": ["chatgpt:testuser:br-left"],
      "must_distinguish": "selected 模式排除左支版本（§4.3）" },
    { "id": "mt-06", "type": "multi_temporal", "query": "偏理论", "branch_scope": "all",
      "acceptable_event_ids": ["chatgpt:testuser:br-left"],
      "must_distinguish": "all 模式左支可查（历史检索语义）" },

    { "id": "in-01", "type": "insufficiency", "query": "找工作",
      "allowed_refusal": true,
      "must_distinguish": "同义表达不扩写（§6.3 边界）：0 命中且属允许拒答" },
    { "id": "in-02", "type": "insufficiency", "query": "完全不存在的词",
      "allowed_refusal": true,
      "must_distinguish": "零命中；报告不得编造" },
    { "id": "in-03", "type": "insufficiency", "query": "职业 求职", "match_mode": "literal",
      "allowed_refusal": true,
      "must_distinguish": "literal 连续子串含空格：语料无此串 → 0 命中（FTS 缩候选后验证拒绝）" },

    { "id": "sem-01", "type": "adversarial", "mode": "get_event", "event_id": "chatgpt:testuser:job01",
      "acceptable_event_ids": ["chatgpt:testuser:job01"],
      "must_distinguish": "正常可访问事件按 ID 可取，citation 可解析（§9.2 100% 门槛）" },
    { "id": "sem-02", "type": "adversarial", "query": "求职",
      "acceptable_event_ids": ["chatgpt:testuser:seek01", "chatgpt:testuser:both"],
      "attribution": { "assistant": ["chatgpt:testuser:seek01"], "owner": ["chatgpt:testuser:both"] },
      "must_distinguish": "seek01 是 assistant 消息：把该句当作用户自述即错误归属（§9.2 门槛 4，机器断言归属 + 人工复核）" },
    { "id": "sem-03", "type": "adversarial", "query": "职业方向变化",
      "acceptable_event_ids": ["chatgpt:testuser:job01"],
      "must_distinguish": "6 字长查询整串命中；FTS 二元 AND 后验证整串" },
    { "id": "sem-04", "type": "adversarial", "query": "右支偏工程实践", "branch_scope": "selected",
      "acceptable_event_ids": ["chatgpt:testuser:br-right"],
      "must_distinguish": "selected 模式包含所选路径右支（§4.3 一致性）" },
    { "id": "sem-05", "type": "adversarial", "query": "职业", "order": "chronological",
      "time": { "date_from": "2026-08-01", "date_to": "2026-08-01", "timezone": "UTC" },
      "acceptable_event_ids": ["chatgpt:testuser:job01", "chatgpt:testuser:rel01", "chatgpt:testuser:both"],
      "forbidden_event_ids": ["chatgpt:testuser:early"],
      "must_distinguish": "时间过滤 [08-01, 08-02)：early(07-31T20:00Z) 被排除；未知时间记录同样不出现" },
    { "id": "sem-06", "type": "adversarial", "query": "时间未知的职业话题",
      "acceptable_event_ids": ["chatgpt:testuser:undat"],
      "must_distinguish": "未知时间记录可按内容检索（不被时间过滤误伤）" }
  ]
}
