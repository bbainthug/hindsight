<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.hindsight.agent-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__BRAIN_HOME__/agent_sync/sync_agents.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BRAIN_HOME</key><string>__BRAIN_HOME__</string>
        <key>BRAIN_CLI</key><string>__BRAIN_CLI__</string>
        <key>PATH</key><string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>
    <key>StartInterval</key><integer>900</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>__BRAIN_HOME__/agent_sync/sync.log</string>
    <key>StandardErrorPath</key><string>__BRAIN_HOME__/agent_sync/sync.log</string>
</dict>
</plist>
